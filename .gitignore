# ---------------------------------------------------------------------------
# Local-only data: real third-party content is NOT redistributed in this repo.
# Recoverable local copies live in data_local/ (see DATASET_CARD.md).
# Tracked files under data/ are small synthetic fixtures only.
# ---------------------------------------------------------------------------
data_local/

# Raw source data and full transcripts (never commit real content)
data/raw/*.csv
data/youtube/transcripts/*
!data/youtube/transcripts/SYNTH01.txt
!data/youtube/transcripts/SYNTH01.json
data/youtube/analysis/

# Derived artifacts (regenerable)
data/processed/*.npy
data/database/*.duckdb
*.duckdb
data/evaluation/*
!data/evaluation/rescored_crossval_summary.json
data/analysis/*
!data/analysis/.gitkeep

# Insecure serialization artifacts
*.pkl
*.pickle

# Agent memory / runtime outputs
data/memory/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
.venv*/
venv*/

# Environment variables with credentials
.env
.env.local
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Model cache
.cache/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# Testing / coverage
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated figures
reports/figures/*.png
reports/figures/*.pdf
