# ReviewInsight AI - environment configuration
# Copy to .env and fill in only what you need.
# Core offline features (tests, offline demo, API health, TF-IDF search,
# dashboard) require NOTHING in this file.

# --- OpenAI (optional; required only for LLM features: /analyze endpoint,
# --- labeling, live evaluation, agent analysis)
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- CORS (optional; comma-separated browser origins allowed to call the API)
# Leave unset for no cross-origin browser access. Wildcards are rejected.
# ALLOWED_ORIGINS=http://localhost:8501

# --- Agent configuration (optional; defaults shown)
AGENT_MODEL=gpt-4o-mini
TEMPERATURE=0.3
MAX_TOKENS=500

# --- Memory storage (optional; default shown)
MEMORY_DIR=data/memory
